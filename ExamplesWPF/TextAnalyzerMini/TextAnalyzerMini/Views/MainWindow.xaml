<Window x:Class="TextAnalyzerMini.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TextAnalyzerMini.Views"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:TextAnalyzerMini.ViewModels"
        FontSize="17"
        Title="Работа с файлами и строками" Height="600" Width="1000">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>


        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="50 10" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBox HorizontalAlignment="Stretch" Margin="10" Text="{Binding FilePath}"></TextBox>
            <Button Content="Открыть" Grid.Column="1" Margin="10" Command="{Binding OpenFileDialogCommand}"></Button>
        </Grid>


        <DockPanel  Grid.Row ="2" Grid.Column="0" >
            <TextBlock FontWeight="Bold" DockPanel.Dock="Top" Text="Исходные данные" TextAlignment="Center" Padding="0 10"/>
            <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="30 10" IsReadOnly="True" Text="{ Binding TextInput }"/>
        </DockPanel>
        <DockPanel  Grid.Row ="3" Grid.Column="0" >
            <TextBlock FontWeight="Bold" DockPanel.Dock="Top" Text="Результирующие данные" TextAlignment="Center" Padding="0 10"/>
            <TextBox  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="30 10" IsReadOnly="True" Text="{ Binding TextOutput }"/>
        </DockPanel>

    </Grid>
</Window>
