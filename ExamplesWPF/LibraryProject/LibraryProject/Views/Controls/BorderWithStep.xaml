<UserControl x:Class="LibraryProject.WPF.Views.Controls.BorderWithStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LibraryProject.WPF.Views.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border BorderThickness="3" CornerRadius="10" BorderBrush="DarkSlateGray"  Margin="25" Padding="15" Grid.Column="0" VerticalAlignment="Top">
            <ContentPresenter Content="{Binding Content, ElementName=Root}" />
        </Border>
        <Border CornerRadius="100" BorderBrush="DarkSlateGray" BorderThickness="3" Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left" Width="40" Height="40" Background="White">
            <TextBlock Text="{Binding NumStep, ElementName=Root}" FontSize="20"  TextAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
